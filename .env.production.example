# Production settings for SmarterASP.NET (IIS + iisnode).
# Copy this file to ".env" in the site root (next to server.js) and fill in every value.
# Never commit or share the filled-in .env.
#
# Do NOT add PORT or HOST: iisnode passes its own PORT (a named pipe), and dotenv never
# overrides it.

# Hides database error details from browsers (always logged in the iisnode log)
NODE_ENV=production

# --- Database (Control panel → Databases → MySQL) ---
# Host shown in the panel, e.g. mysql5049.site4now.net (not localhost)
DB_HOST=mysqlXXXX.site4now.net
# User and database names as created in the panel — both carry your account prefix
DB_USER=abc123_inventory
DB_PASS=the-password-you-set-in-the-panel
DB_NAME=db_abc123_inventory

# --- Web ---
# The site's own address. The app is served from the same domain as the API, so this is only
# a safety net for browser calls from other sites (comma-separate several, no trailing slash).
CORS_ORIGINS=https://your-site.example

# iisnode forwards the visitor's address in X-Forwarded-For (web.config enableXFF="true");
# 1 = trust exactly one proxy hop. Without it every visitor shares one rate-limit bucket.
TRUST_PROXY=1

# Requests per minute per visitor before "429 Too Many Requests"
RATE_LIMIT_WRITES_PER_MIN=120
RATE_LIMIT_READS_PER_MIN=600
