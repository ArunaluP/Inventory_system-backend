# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=production

# Database — use the least-privileged account from deploy/create_app_db_user.sql, NOT root
DB_HOST=127.0.0.1
DB_USER=inventory_app
DB_PASS=change-me-to-a-long-random-password
DB_NAME=inventory_system

# Browser origins allowed to call the API (comma-separated), e.g. https://boq.example.com
CORS_ORIGINS=https://your-frontend-domain.example

# Behind Nginx / a load balancer: number of proxy hops (usually 1). Leave empty without a proxy.
TRUST_PROXY=1

# Requests per minute per client before 429 Too Many Requests
RATE_LIMIT_WRITES_PER_MIN=120
RATE_LIMIT_READS_PER_MIN=600

# Bind the API to localhost so it is only reachable through the web server (production)
HOST=127.0.0.1
